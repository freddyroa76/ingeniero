<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ábaco de Compresión - Ing. Freddy Roa</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Paleta Web Ing. Freddy Roa */
            --bg-page: #f8f9fa;
            --disc-outer: #ffffff;
            --disc-inner: #fdfdfd;
            --rim-color: #111625; /* Azul Marino Oscuro de la web */
            --accent-color: #cddc39; /* Verde Lima/Amarillo de la web */
            --text-dark: #111625;
            --text-box: #111625;
            --tick-major: #000000;
            --tick-minor: #555555;
            --font-sans: 'Inter', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            --shadow-disc: 0 12px 35px rgba(0,0,0,0.15);
        }

        body {
            font-family: var(--font-sans);
            background-color: var(--bg-page);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            color: var(--text-dark);
            -webkit-font-smoothing: antialiased;
        }

        .header { text-align: center; margin-bottom: 20px; }
        .header h1 { font-size: 1.6rem; color: var(--rim-color); margin: 0 0 5px; text-transform: uppercase; letter-spacing: 1px; font-weight: 800; }
        .header p { margin: 0 0 5px 0; font-size: 1rem; color: #555; font-weight: 700; }
        .header a { font-size: 0.85rem; color: var(--text-dark); font-weight: 600; text-decoration: none; transition: color 0.2s; }
        .header a:hover { color: var(--accent-color); }

        .abacus-wrapper {
            position: relative;
            width: 100%;
            max-width: 700px;
            aspect-ratio: 1 / 1;
            height: auto;
            user-select: none;
            touch-action: none;
            filter: drop-shadow(0 20px 40px rgba(0,0,0,0.15));
        }

        .abacus-svg { width: 100%; height: 100%; display: block; }

        /* Ajuste para que los SVG giren desde su centro real con CSS */
        #outerDisc, #innerDisc {
            transform-origin: 400px 400px;
        }

        /* Panel central de resultados digital */
        .result-panel {
            position: absolute;
            top: 41%; /* Datos de salida más arriba */
            left: 50%;
            transform: translate(-50%, -50%);
            background: #ffffff;
            border: 2px solid var(--accent-color);
            border-radius: 8px;
            padding: 12px 20px;
            text-align: center;
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.05), 0 6px 15px rgba(0,0,0,0.1);
            pointer-events: none;
            z-index: 30;
            width: 160px;
            transition: transform 0.2s ease;
        }

        .res-label { font-size: 0.6rem; font-weight: 800; color: #555; text-transform: uppercase; letter-spacing: 1px; }
        .res-value { font-family: var(--font-mono); font-size: 2.2rem; font-weight: 800; color: var(--rim-color); line-height: 1.1; margin: 5px 0; }
        .res-unit { font-size: 0.65rem; font-weight: 800; color: #666; }
        .res-divider { height: 2px; background: var(--bg-page); margin: 8px 0; }
        .res-cr { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 800; color: var(--text-dark); }
        .res-stages { font-size: 0.65rem; font-weight: 700; color: #666; margin-top: 2px; }

        /* Dashboard Inferior */
        .dashboard {
            display: flex;
            gap: 20px;
            margin-top: 30px;
            background: #fff;
            padding: 15px 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border: 1px solid #e2e8f0;
        }

        .dash-item { text-align: center; min-width: 90px; }
        .dash-label { font-size: 0.65rem; font-weight: 700; color: #888; text-transform: uppercase; margin-bottom: 5px; }
        .dash-val { font-family: var(--font-mono); font-size: 1.2rem; font-weight: 700; color: var(--text-dark); display: flex; align-items: center; justify-content: center; gap: 5px; }
        
        /* Estilos de los inputs digitables */
        .dash-input {
            width: 70px;
            font-family: var(--font-mono);
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-dark);
            text-align: center;
            border: 2px solid #e2e8f0;
            border-radius: 6px;
            padding: 4px;
            outline: none;
            background: #f8f9fa;
            transition: border-color 0.2s;
        }
        .dash-input:focus { border-color: var(--accent-color); background: #fff; }

        .pointer-arrow { position: absolute; top: -15px; left: 50%; transform: translateX(-50%); z-index: 25; pointer-events: none; }

        /* Responsiveness */
        @media (max-width: 750px) {
            .abacus-wrapper { max-width: 100%; }
            .dashboard { flex-wrap: wrap; justify-content: center; }
            .result-panel { transform: translate(-50%, -50%) scale(0.9); }
        }
        @media (max-width: 480px) {
            .result-panel { transform: translate(-50%, -50%) scale(0.75); }
        }
    </style>
</head>
<body>

<div class="header">
    <h1>Ábaco de Compresión</h1>
    <p>Ing. Mecánico Freddy Roa Monsalvo</p>
    <a href="https://freddyroa76.github.io/ingeniero/" target="_blank">https://freddyroa76.github.io/ingeniero/</a>
</div>

<div class="abacus-wrapper" id="wrap">
    <svg class="pointer-arrow" width="30" height="40" viewBox="0 0 30 40">
        <polygon points="15,40 0,0 30,0" fill="var(--accent-color)" stroke="var(--rim-color)" stroke-width="2"/>
    </svg>

    <svg class="abacus-svg" id="svg" viewBox="0 0 800 800">
        <defs>
            <filter id="shadowOuter" x="-10%" y="-10%" width="120%" height="120%">
                <feDropShadow dx="0" dy="10" stdDeviation="15" flood-opacity="0.15"/>
            </filter>
            <filter id="shadowInner" x="-10%" y="-10%" width="120%" height="120%">
                <feDropShadow dx="0" dy="5" stdDeviation="8" flood-opacity="0.10"/>
            </filter>
            
            <path id="curveOuter" d="M 50,400 A 350,350 0 1,1 750,400" />
            
            <path id="curveInner" d="M 150,400 A 250,250 0 1,1 650,400" />
        </defs>

        <g id="outerDisc">
            <circle cx="400" cy="400" r="380" fill="var(--disc-outer)" stroke="var(--rim-color)" stroke-width="16" filter="url(#shadowOuter)"/>
            
            <text font-family="var(--font-sans)" font-size="14" font-weight="800" fill="var(--text-dark)" letter-spacing="1.5">
                <textPath href="#curveOuter" startOffset="75%" text-anchor="middle">DISCHARGE PRESSURE (PSIG)</textPath>
            </text>
        </g>

        <g id="innerDisc" style="cursor:grab;">
            <circle cx="400" cy="400" r="285" fill="var(--disc-inner)" stroke="#cccccc" stroke-width="2" filter="url(#shadowInner)"/>
            
            <text font-family="var(--font-sans)" font-size="14" font-weight="700" fill="var(--text-dark)" letter-spacing="1.5">
                <textPath href="#curveInner" startOffset="30%" text-anchor="middle" dominant-baseline="hanging">SUCTION PRESSURE (PSIG)</textPath>
            </text>

            <rect x="310" y="490" width="180" height="90" fill="#f8f9fa" rx="8" stroke="var(--accent-color)" stroke-width="2" opacity="0.95"/>
            <text x="400" y="510" font-family="var(--font-sans)" font-size="11" fill="var(--text-box)" text-anchor="middle">
                <tspan x="400" dy="0" font-weight="800">HP figures based upon:</tspan>
                <tspan x="400" dy="16" font-weight="600">Abs. Press. = 14.65 p.s.i.a.</tspan>
                <tspan x="400" dy="16" font-weight="600">S.G. = 0.65   N = 1.26</tspan>
                <tspan x="400" dy="16" font-weight="600">Suction Temp. = 80° F</tspan>
                <tspan x="400" dy="16" font-weight="600">Interstage Temp. = 120° F</tspan>
            </text>
            
            <circle cx="400" cy="400" r="25" fill="#e0e0e0" stroke="#999" stroke-width="2"/>
            <circle cx="400" cy="400" r="8" fill="var(--rim-color)"/>
        </g>
    </svg>

    <div class="result-panel">
        <div class="res-label">Aprox. Requerido</div>
        <div class="res-value" id="val-bhp">--</div>
        <div class="res-unit">HP / MMSCF/D</div>
        <div class="res-divider"></div>
        <div class="res-cr" id="val-cr">CR: --</div>
        <div class="res-stages" id="val-stages">--</div>
    </div>
</div>

<div class="dashboard">
    <div class="dash-item">
        <div class="dash-label">Succión</div>
        <div class="dash-val"><input type="number" id="input-ps" class="dash-input" min="0" max="1000"> <span style="font-size:0.5em;color:#888">psig</span></div>
    </div>
    <div class="dash-item">
        <div class="dash-label">Descarga</div>
        <div class="dash-val"><input type="number" id="input-pd" class="dash-input" min="0" max="4000"> <span style="font-size:0.5em;color:#888">psig</span></div>
    </div>
    <div class="dash-item">
        <div class="dash-label">Relación (CR)</div>
        <div class="dash-val" id="dash-cr" style="margin-top: 5px;">--</div>
    </div>
</div>

<script>
(function() {
    'use strict';

    // Parámetros Termodinámicos (GPSA & Notas del Ábaco)
    const k = 1.26, Ts = 540, Ti = 580, eta = 0.775, Patm = 14.65, CR_MAX = 3.8;
    const S_MIN = 0, S_MAX = 1000, D_MIN = 0, D_MAX = 4000;
    
    // Configuración Angular
    const ARC = 260; 
    const ARC0 = 30; 

    // Helpers Logarítmicos usando Presión Absoluta
    function vL(v) { return Math.log10(v + Patm); }
    function v2a(v, mn, mx) { return ARC0 + ((vL(v) - vL(mn)) / (vL(mx) - vL(mn))) * ARC; }
    function a2v(a, mn, mx) {
        const f = (a - ARC0) / ARC;
        return Math.pow(10, vL(mn) + f * (vL(mx) - vL(mn))) - Patm;
    }

    // SVG Helpers
    const CX = 400, CY = 400;
    function p2xy(r, a) { const rd = (a - 90) * Math.PI / 180; return { x: CX + r * Math.cos(rd), y: CY + r * Math.sin(rd) }; }
    function mk(tag, at) { const el = document.createElementNS('http://www.w3.org/2000/svg', tag); for (const [k, v] of Object.entries(at)) el.setAttribute(k, v); return el; }

    // Generador manual de ticks
    function getScaleTicks(max) {
        let major = [], minor = [];
        for(let i=0; i<=30; i++) { if(i%5===0) major.push(i); else minor.push(i); }
        for(let i=32; i<=100; i+=2) { if(i%10===0) major.push(i); else minor.push(i); }
        for(let i=110; i<=300; i+=10) { if(i%50===0) major.push(i); else minor.push(i); }
        for(let i=350; i<=1000; i+=50) { if(i%100===0) major.push(i); else minor.push(i); }
        if(max > 1000) {
            for(let i=1100; i<=max; i+=100) { if(i%500===0) major.push(i); else minor.push(i); }
        }
        return { major, minor };
    }

    // Dibujar Escalas
    function buildScale(gId, min, max, isOuter) {
        const g = document.getElementById(gId);
        const { major, minor } = getScaleTicks(max);
        
        const B = isOuter ? 287 : 283; 
        const TIP_M = isOuter ? B + 18 : B - 18; 
        const TIP_m = isOuter ? B + 10 : B - 10; 
        const R_LBL = isOuter ? B + 32 : B - 28;

        major.forEach(v => {
            if(v > max) return;
            const a = v2a(v, min, max);
            const p1 = p2xy(B, a), p2 = p2xy(TIP_M, a);
            g.appendChild(mk('line', { x1:p1.x, y1:p1.y, x2:p2.x, y2:p2.y, stroke:'var(--tick-major)', 'stroke-width': '2' }));

            const pL = p2xy(R_LBL, a);
            const tx = mk('text', { x:pL.x, y:pL.y, fill:'var(--text-dark)', 'font-family':'var(--font-sans)', 'font-size':'13', 'font-weight':'700', 'text-anchor':'middle', 'dominant-baseline':'central' });
            
            let rot = a + (isOuter ? -90 : 90); 
            tx.setAttribute('transform', `rotate(${rot}, ${pL.x}, ${pL.y})`);
            tx.textContent = v;
            g.appendChild(tx);
        });

        minor.forEach(v => {
            if(v > max) return;
            const a = v2a(v, min, max);
            const p1 = p2xy(B, a), p2 = p2xy(TIP_m, a);
            g.appendChild(mk('line', { x1:p1.x, y1:p1.y, x2:p2.x, y2:p2.y, stroke:'var(--tick-minor)', 'stroke-width': '1' }));
        });
    }

    buildScale('outerDisc', D_MIN, D_MAX, true);
    buildScale('innerDisc', S_MIN, S_MAX, false);

    // Motor de Cálculo
    function computeBHP(Ps, Pd) {
        const P1 = Ps + Patm, P2 = Pd + Patm;
        if (P1 <= 0 || P2 <= P1) return { bhp: 0, cr: 1, stages: 1 };
        const CR = P2 / P1;
        const stages = Math.max(1, Math.ceil(Math.log(CR) / Math.log(CR_MAX)));
        const CRs = Math.pow(CR, 1 / stages);
        const exp = (k - 1) / k, coeff = 43.64 / eta, kF = k / (k - 1);
        const term = Math.pow(CRs, exp) - 1;
        
        let bhp = 0;
        for (let s = 0; s < stages; s++) bhp += coeff * kF * term * ((s === 0 ? Ts : Ti) / 520);
        return { bhp, cr: CR, stages };
    }

    // Nodos UI
    const svg = document.getElementById('svg'), wrap = document.getElementById('wrap');
    const outerG = document.getElementById('outerDisc'), innerG = document.getElementById('innerDisc');
    const inputPs = document.getElementById('input-ps'), inputPd = document.getElementById('input-pd');
    
    let dragging = false, dragA = 0, active = null;
    let outerR = -v2a(1200, D_MIN, D_MAX);
    let innerR = -v2a(400, S_MIN, S_MAX);

    // Alternar transición suave (apagada al arrastrar, encendida al digitar)
    function setSmoothRotation(isSmooth) {
        innerG.style.transition = isSmooth ? 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)' : 'none';
        outerG.style.transition = isSmooth ? 'transform 0.5s cubic-bezier(0.25, 1, 0.5, 1)' : 'none';
    }

    function update() {
        outerG.style.transform = `rotate(${outerR}deg)`;
        innerG.style.transform = `rotate(${innerR}deg)`;
        
        let Ps = Math.max(S_MIN, Math.min(S_MAX, a2v(-innerR, S_MIN, S_MAX)));
        let Pd = Math.max(D_MIN, Math.min(D_MAX, a2v(-outerR, D_MIN, D_MAX)));
        
        const r = computeBHP(Ps, Pd);
        
        document.getElementById('val-bhp').textContent = r.bhp > 0 ? Math.round(r.bhp) : '--';
        document.getElementById('val-cr').textContent = 'CR: ' + r.cr.toFixed(2);
        document.getElementById('val-stages').textContent = r.stages === 1 ? 'UNA ETAPA' : (r.stages === 2 ? 'DOS ETAPAS' : 'TRES ETAPAS');
        
        // Actualiza los inputs solo si no están siendo editados activamente
        if (document.activeElement !== inputPs) inputPs.value = Math.round(Ps);
        if (document.activeElement !== inputPd) inputPd.value = Math.round(Pd);
        document.getElementById('dash-cr').textContent = r.cr.toFixed(2);
    }

    // Listeners para Digitación en Ventana Inferior
    inputPs.addEventListener('change', function() {
        let val = parseFloat(this.value);
        if(isNaN(val)) return;
        val = Math.max(S_MIN, Math.min(S_MAX, val));
        this.value = val;
        innerR = -v2a(val, S_MIN, S_MAX);
        setSmoothRotation(true);
        update();
    });

    inputPd.addEventListener('change', function() {
        let val = parseFloat(this.value);
        if(isNaN(val)) return;
        val = Math.max(D_MIN, Math.min(D_MAX, val));
        this.value = val;
        outerR = -v2a(val, D_MIN, D_MAX);
        setSmoothRotation(true);
        update();
    });

    // Control de Arrastre (Drag)
    function getAngle(e) {
        const rc = svg.getBoundingClientRect();
        const x = e.touches ? e.touches[0].clientX : e.clientX;
        const y = e.touches ? e.touches[0].clientY : e.clientY;
        const dx = x - (rc.left + rc.width/2), dy = y - (rc.top + rc.height/2);
        return Math.atan2(dy, dx) * 180 / Math.PI + 90;
    }
    
    function getDist(e) {
        const rc = svg.getBoundingClientRect();
        const x = e.touches ? e.touches[0].clientX : e.clientX;
        const y = e.touches ? e.touches[0].clientY : e.clientY;
        const dx = (x - (rc.left + rc.width/2)) * (800/rc.width), dy = (y - (rc.top + rc.height/2)) * (800/rc.height);
        return Math.sqrt(dx*dx + dy*dy);
    }

    function onDown(e) {
        if(e.target.tagName === 'INPUT') return; // Evita interferir con los inputs
        e.preventDefault();
        const d = getDist(e);
        if (d < 35) return; 
        active = d <= 285 ? 'inner' : 'outer';
        dragging = true;
        dragA = getAngle(e);
        setSmoothRotation(false); // Apaga la animación para que el arrastre sea instantáneo
        document.body.style.cursor = 'grabbing';
    }

    function onMove(e) {
        if (!dragging) return;
        e.preventDefault();
        const a = getAngle(e), delta = a - dragA;
        dragA = a;
        if (active === 'inner') innerR += delta; else outerR += delta;
        update();
    }

    function onUp() { dragging = false; active = null; document.body.style.cursor = ''; }

    wrap.addEventListener('mousedown', onDown); window.addEventListener('mousemove', onMove); window.addEventListener('mouseup', onUp);
    wrap.addEventListener('touchstart', onDown, {passive: false}); window.addEventListener('touchmove', onMove, {passive: false}); window.addEventListener('touchend', onUp);

    // Inicializar apagando la transición y ajustando posiciones
    setSmoothRotation(false);
    update();
})();
</script>
</body>
</html>